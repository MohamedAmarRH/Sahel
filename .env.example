# ============================================
# CONFIGURATION YAOURT DU SAHEL - BACKEND
# ============================================

# Port du serveur (par défaut: 3000)
PORT=3000

# URL du frontend (pour CORS)
# En production, mettez l'URL de votre site déployé
FRONTEND_URL=https://votre-site-frontend.com

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Créez un compte sur https://supabase.com
# Créez un nouveau projet
# Allez dans Settings > API pour trouver ces valeurs

SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-public

# ============================================
# INSTRUCTIONS DE CONFIGURATION
# ============================================
# 1. Copiez ce fichier en .env
# 2. Remplacez les valeurs par vos vraies credentials Supabase
# 3. Installez les dépendances: npm install
# 4. Démarrez le serveur: npm start
# ============================================
